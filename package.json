{
  "name": "flash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flash — приватный видеодневник, который сам собирает фильмы из моментов твоей жизни",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n db,web,worker -c green,cyan,magenta \"npm:dev:db\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:db": "tsx scripts/dev-db.ts",
    "dev:web": "next dev -p 3000",
    "dev:worker": "tsx watch --clear-screen=false src/worker/index.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "start:worker": "tsx src/worker/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "music": "tsx scripts/generate-music.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "vapid": "tsx scripts/generate-vapid.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/onest": "^0.4.2",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@napi-rs/canvas": "^1.2.0",
    "@tailwindcss/turbopack": "4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "^2.5.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yazl": "^2.4.2",
    "concurrently": "^10.0.7",
    "embedded-postgres": "19.0.0-beta.20",
    "ffmpeg-static": "^5.3.0",
    "selfsigned": "^5.5.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
