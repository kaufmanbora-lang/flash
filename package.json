{
  "name": "flash",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Flash — приватный видеодневник, который сам собирает фильмы из моментов твоей жизни. Работает целиком в браузере.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve-out.mjs",
    "music": "tsx scripts/generate-music.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@tailwindcss/turbopack": "4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.78.0",
    "mediabunny": "^1.66.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "^2.5.1",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/onest": "^0.4.2",
    "@napi-rs/canvas": "^1.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fake-indexeddb": "^6.2.5",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
