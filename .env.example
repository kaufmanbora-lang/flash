# ─────────────────────────────────────────────────────────────
#  Flash — переменные окружения
#  Скопируйте файл в .env и поправьте значения.
#  Для локальной разработки (npm run dev) файл не обязателен:
#  все значения ниже имеют рабочие значения по умолчанию.
# ─────────────────────────────────────────────────────────────

# Публичный адрес приложения (нужен для ссылок в push-уведомлениях).
# В продакшене — обязательно https, иначе камера, PWA и push работать не будут.
APP_URL=http://localhost:3000

# Секрет для подписи cookie-сессий и временных ссылок на файлы.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string

# Необязательный код приглашения. Если задан — регистрация только по нему
# (удобно для «себя и небольшого круга друзей»).
INVITE_CODE=

# ── База данных ──────────────────────────────────────────────
# По умолчанию — встроенный Postgres из `npm run dev:db` (порт 15432).
DATABASE_URL=postgres://flash:flash@127.0.0.1:15432/flash

# ── Хранилище видео ──────────────────────────────────────────
# local — папка на диске (STORAGE_LOCAL_DIR), s3 — любое S3-совместимое хранилище.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage

# Для STORAGE_DRIVER=s3 (MinIO, AWS S3, Cloudflare R2, Backblaze B2 …)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=flash
S3_ACCESS_KEY=flash
S3_SECRET_KEY=flash-secret-key
S3_FORCE_PATH_STYLE=true

# Лимит хранилища на одного пользователя в гигабайтах (0 — без лимита).
STORAGE_QUOTA_GB=0

# ── Push-уведомления (VAPID) ─────────────────────────────────
# Если оставить пустыми, ключи будут созданы автоматически и сохранены в базе.
# Сгенерировать вручную: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-сервисов. Apple требует настоящий mailto: или https-адрес.
VAPID_SUBJECT=mailto:you@example.com

# ── Монтаж ───────────────────────────────────────────────────
# Пути к бинарникам. Пусто — берутся из PATH, затем из npm-пакетов (dev).
FFMPEG_PATH=
FFPROBE_PATH=
# Качество H.264: меньше CRF — лучше качество и больше файл (16–23 разумно).
FILM_CRF=18
# Скорость кодирования: ultrafast … veryslow.
FILM_PRESET=fast
# Папка для временных файлов монтажа (по умолчанию системная temp).
WORK_DIR=

# Порт health-check воркера.
WORKER_PORT=3101
